# Public (safe to expose). Nothing secret may ever use the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SITE_URL=https://terroa.ca

# Server-only. Never commit real values. All optional: without them the site runs in phase 1 mode
# (quotes validated but not stored or emailed).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

RESEND_API_KEY=
MAIL_FROM=            # e.g. "Terroa <soumissions@terroa.ca>" on a verified sending domain
QUOTE_NOTIFY_TO=      # Terroa staff inbox
SEND_CUSTOMER_CONFIRMATIONS=false   # stays false until Vy approves emailing real customers

CRON_SECRET=          # random 32+ chars; Vercel Cron sends it as a Bearer token

# Plan reader (phase 3). OFF until Vy confirms the privacy impact assessment: plans are sent to the
# Anthropic API (outside Quebec). Without all four values the page runs the labelled demo.
PLAN_READER_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=      # required, no default. Suggested: claude-opus-5-5 (confirm with Vy; do not downgrade)
